# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server ports
PORT=5000
FLASK_PORT=5001
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
APP_NAME=ClipForge AI

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================

# Local PostgreSQL (Development)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/clipforge

# Remote PostgreSQL (Production - Neon, Supabase, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# Generate strong random secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Token expiration times
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=30d

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

# Gmail Configuration (Recommended for development)
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password (not your regular password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=ClipForge <noreply@clipforge.com>

# Alternative SMTP Providers:
# SendGrid: smtp.sendgrid.net, port 587
# Mailgun: smtp.mailgun.org, port 587
# Outlook: smtp-mail.outlook.com, port 587

# =============================================================================
# GOOGLE OAUTH 2.0
# =============================================================================

# Setup Instructions:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Create OAuth 2.0 Client ID (Web application)
# 5. Add authorized redirect URIs:
#    - http://localhost:5173/auth/callback
#    - http://localhost:5000/api/auth/google/callback
#    - https://your-domain.com/auth/callback (production)

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
# Free tier: 60 requests per minute
GEMINI_API_KEY=your-gemini-api-key-here
USE_GEMINI=true
GEMINI_MODEL=gemini-2.0-flash-exp

# Whisper AI Model (configured in video_processor.py)
# Options: tiny, base, small, medium, large
# Default: base (good balance of speed and accuracy)

# =============================================================================
# CLOUDINARY CONFIGURATION (Cloud Storage)
# =============================================================================

# Setup Instructions:
# 1. Sign up at: https://cloudinary.com/users/register/free
# 2. Free tier: 25 GB storage + 25 GB bandwidth/month
# 3. Get credentials from: https://console.cloudinary.com/
# 4. Copy Cloud Name, API Key, and API Secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Enable/disable cloud storage (set to false for local storage only)
USE_CLOUD_STORAGE=true

# =============================================================================
# SOCIAL MEDIA PLATFORM OAUTH (Optional - for publishing features)
# =============================================================================

# -----------------------------------------------------------------------------
# Instagram Graph API (via Meta Business)
# -----------------------------------------------------------------------------
# Setup Instructions:
# 1. Go to: https://developers.facebook.com/apps/
# 2. Create new app (Business type)
# 3. Add products: Facebook Login + Instagram Graph API
# 4. Configure OAuth redirect URI: http://localhost:5000/api/platform/instagram/callback
# 5. Requirements:
#    - User must have Instagram Creator or Business account
#    - Instagram account must be connected to a Facebook Page
#    - App must be in Live mode (after review)
# 6. Required permissions (need App Review):
#    - pages_show_list (approved by default)
#    - pages_read_engagement (approved by default)
#    - instagram_basic (requires review)
#    - instagram_content_publish (requires review)

INSTAGRAM_APP_ID=your-meta-app-id
INSTAGRAM_APP_SECRET=your-meta-app-secret

# Instagram API Version (current stable version)
INSTAGRAM_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# TikTok API (Coming Soon)
# -----------------------------------------------------------------------------
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# -----------------------------------------------------------------------------
# YouTube Data API v3
# -----------------------------------------------------------------------------
# Setup Instructions:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 credentials
# 4. Add redirect URI: http://localhost:5000/api/platforms/youtube/callback

# YOUTUBE_CLIENT_ID=your-youtube-client-id
# YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# -----------------------------------------------------------------------------
# Twitter/X API
# -----------------------------------------------------------------------------
# TWITTER_API_KEY=your-twitter-api-key
# TWITTER_API_SECRET=your-twitter-api-secret
# TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# -----------------------------------------------------------------------------
# Facebook API
# -----------------------------------------------------------------------------
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Maximum login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# Session cleanup interval in hours (removes expired sessions)
SESSION_CLEANUP_INTERVAL=24

# Enable security event logging
ENABLE_SECURITY_LOGGING=true

# Enable rate limiting (recommended for production)
ENABLE_RATE_LIMITING=true

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file size for video uploads (in MB)
MAX_FILE_SIZE=500

# Allowed video formats
ALLOWED_EXTENSIONS=mp4,mov,avi,mkv,webm

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================

# Default video processing settings
DEFAULT_CLIP_DURATION=45
DEFAULT_NUM_CLIPS=5
DEFAULT_VIDEO_QUALITY=720p
DEFAULT_MIN_VIRAL_SCORE=75

# FFmpeg encoding settings (configured in video_processor.py)
# CRF: 0-51 (lower = better quality, larger file size)
# Preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug mode (verbose logging)
DEBUG=false

# Enable CORS for development
CORS_ENABLED=true

# =============================================================================
# PRODUCTION NOTES
# =============================================================================

# 1. NEVER commit this file with real credentials
# 2. Use environment variables from your hosting provider
# 3. Generate strong, unique secrets for JWT tokens
# 4. Use HTTPS in production (update FRONTEND_URL and BACKEND_URL)
# 5. Set NODE_ENV=production
# 6. Disable DEBUG mode
# 7. Enable rate limiting and security logging
# 8. Use a managed PostgreSQL service (Neon, Supabase, Railway)
# 9. Consider using a CDN for video delivery
# 10. Set up proper backup and monitoring

# =============================================================================
# QUICK START CHECKLIST
# =============================================================================

# ✅ 1. Install PostgreSQL and create 'clipforge' database
# ✅ 2. Generate JWT secrets (use the command above)
# ✅ 3. Set up Gmail App Password for email
# ✅ 4. Create Google OAuth credentials
# ✅ 5. Get Gemini API key
# ✅ 6. (Optional) Set up Cloudinary account
# ✅ 7. (Optional) Configure social media platform APIs
# ✅ 8. Copy this file to .env and fill in your values
# ✅ 9. Run migrations: node migrations/run-migrations.js
# ✅ 10. Start servers: python app.py & npm start
