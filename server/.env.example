# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_NAME=ClipForge AI

# Database (Neon PostgreSQL)
#DATABASE_URL=

# JWT Secrets (Generate strong random strings)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Configuration (SMTP)
# For Gmail: smtp.gmail.com, port 587
# For SendGrid: smtp.sendgrid.net, port 587
# For Mailgun: smtp.mailgun.org, port 587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Security Notes:
# 1. Never commit this file with real credentials
# 2. Use strong, unique secrets for JWT tokens
# 3. For Gmail, use App Passwords: https://support.google.com/accounts/answer/185833
# 4. For production, use environment variables from your hosting provider

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------

# Maximum login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# JWT token expiration times
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Session cleanup interval in hours
SESSION_CLEANUP_INTERVAL=24

# Enable security logging
ENABLE_SECURITY_LOGGING=true

# Rate limiting (set to false to disable in development)
ENABLE_RATE_LIMITING=true

# -----------------------------------------------------------------------------
# AI CONFIGURATION
# -----------------------------------------------------------------------------

# Google Gemini API Key for video analysis
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# PLATFORM OAUTH CREDENTIALS
# -----------------------------------------------------------------------------

# Instagram Graph API (Meta/Facebook Business App)
# Create app at: https://developers.facebook.com/apps/
# App Type: Business
# Products: Facebook Login + Instagram Graph API
# Requirements:
#   - User must have Instagram Creator or Business account
#   - Instagram account must be connected to a Facebook Page
#   - Page must be managed by the user
INSTAGRAM_APP_ID=your-meta-app-id
INSTAGRAM_APP_SECRET=your-meta-app-secret
