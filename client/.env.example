# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API Configuration
# Development: http://localhost:5000
# Production: https://your-api-domain.com
VITE_API_URL=http://localhost:5000

# =============================================================================
# GOOGLE OAUTH CLIENT ID
# =============================================================================

# Get from: https://console.cloud.google.com/apis/credentials
# Must match the client ID configured in server/.env
# This is safe to expose in frontend (it's a public identifier)

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# App Name (displayed in UI)
# VITE_APP_NAME=ClipForge AI

# Enable debug mode (verbose console logging)
# VITE_DEBUG=false

# API timeout in milliseconds
# VITE_API_TIMEOUT=30000

# =============================================================================
# PRODUCTION NOTES
# =============================================================================

# 1. Copy this file to .env.local for development
# 2. For production, set VITE_API_URL to your backend domain
# 3. Ensure VITE_GOOGLE_CLIENT_ID matches server configuration
# 4. Never commit .env.local to version control
# 5. Vite exposes only variables prefixed with VITE_

# =============================================================================
# QUICK START
# =============================================================================

# 1. Copy this file: cp .env.example .env.local
# 2. Update VITE_GOOGLE_CLIENT_ID with your Google OAuth client ID
# 3. Start dev server: npm run dev
